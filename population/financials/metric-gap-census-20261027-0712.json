  "census_sql": "WITH admissions AS MATERIALIZED(SELECT * FROM population_top3000_202608_202609_v1.financial_shared_admission_v1 WHERE admitted_at<='2026-10-27T07:12:18.202366Z'),\ndocs AS MATERIALIZED(SELECT a.document_key,a.manifest_sha256,d.derived_sha256,a.manifest->>'time_role' time_role,d.source_fact_count,d.normalized_at,d.derived_at FROM admissions a LEFT JOIN population_top3000_202608_202609_v1.financial_shared_document_v1 d USING(document_key)),\neligible AS MATERIALIZED(SELECT * FROM docs WHERE derived_at<='2026-10-27T07:12:18.202366Z'),\nnames AS(SELECT unnest(ARRAY['assets','capex','cash','cash_ratio','common_shares_outstanding','cost_of_revenue','current_assets','current_liabilities','current_ratio','debt_current','debt_noncurrent','debt_total_reported','eps_basic','eps_diluted','equity','equity_including_noncontrolling','equity_to_assets','free_cash_flow','gross_margin','gross_profit','liabilities','liabilities_to_assets','net_income','net_margin','operating_cash_flow','operating_income','operating_margin','revenue','shares_outstanding','short_term_borrowings','weighted_shares_basic','weighted_shares_diluted']) metric),\nmetric_cells AS MATERIALIZED(SELECT m.document_key,m.metric,count(*) rows,\ncount(*) FILTER(WHERE jsonb_typeof(m.record->'value')='number') numeric_rows,\ncount(*) FILTER(WHERE jsonb_typeof(m.record->'value')='number' AND m.record->>'current_report_period'='true') current_numeric_rows,\ncount(*) FILTER(WHERE m.record->>'state' LIKE '%CONFLICT%') conflicts,\ncount(*) FILTER(WHERE m.record_sha256 IS DISTINCT FROM encode(sha256(convert_to(m.record::text,'UTF8')),'hex')) hash_errors\nFROM population_top3000_202608_202609_v1.financial_shared_metric_v1 m JOIN eligible e USING(document_key) GROUP BY 1,2),\ncells AS MATERIALIZED(SELECT e.document_key,n.metric,r.requirement_state,coalesce(m.rows,0) metric_rows,coalesce(m.numeric_rows,0) numeric_rows,coalesce(m.current_numeric_rows,0) current_numeric_rows,coalesce(m.conflicts,0) conflicts,coalesce(m.hash_errors,0) hash_errors\nFROM eligible e CROSS JOIN names n LEFT JOIN metric_cells m ON m.document_key=e.document_key AND m.metric=n.metric LEFT JOIN population_top3000_202608_202609_v1.financial_shared_requirement_v1 r ON r.document_key=e.document_key AND r.family_id='F03' AND r.requirement_key=n.metric),\nsummary AS(SELECT metric,count(*) document_cells,count(*) FILTER(WHERE requirement_state IS NULL) missing_requirement_states,\ncount(*) FILTER(WHERE numeric_rows>0) any_period_numeric,\ncount(*) FILTER(WHERE current_numeric_rows>0) report_end_numeric,\ncount(*) FILTER(WHERE numeric_rows>0 AND current_numeric_rows=0) other_period_only,\ncount(*) FILTER(WHERE numeric_rows=0) no_numeric_value,\ncount(*) FILTER(WHERE conflicts>0) conflict_cells,sum(hash_errors) hash_errors FROM cells GROUP BY metric)\nSELECT (SELECT count(*) FROM admissions) admitted_documents,(SELECT count(*) FROM eligible) derived_documents_at_cutoff,\n(SELECT count(*) FROM docs WHERE derived_at IS NULL OR derived_at>'2026-10-27T07:12:18.202366Z') not_derived_at_cutoff,\n(SELECT jsonb_object_agg(time_role,n) FROM(SELECT time_role,count(*) n FROM docs GROUP BY time_role) t) admitted_time_roles,\n(SELECT jsonb_agg(jsonb_build_object('document_key',document_key,'admission_sha256',manifest_sha256,'derived_sha256',derived_sha256) ORDER BY document_key) FROM eligible) input_manifest,\n(SELECT jsonb_agg(to_jsonb(s) ORDER BY metric) FROM summary s) metrics,\n(SELECT encode(sha256(convert_to(string_agg(to_jsonb(c)::text,E'\\n' ORDER BY document_key,metric),'UTF8')),'hex') FROM cells c) cell_manifest_sha256;",
