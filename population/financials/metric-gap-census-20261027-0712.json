  "related_concept_sql": "WITH eligible AS MATERIALIZED(SELECT d.document_key FROM population_top3000_202608_202609_v1.financial_shared_document_v1 d JOIN population_top3000_202608_202609_v1.financial_shared_admission_v1 a USING(document_key) WHERE d.derived_at<='2026-10-27T07:12:18.202366Z' AND a.admitted_at<='2026-10-27T07:12:18.202366Z'),\ngaps AS MATERIALIZED(SELECT r.document_key,r.requirement_key metric FROM population_top3000_202608_202609_v1.financial_shared_requirement_v1 r JOIN eligible USING(document_key) WHERE family_id='F03' AND requirement_state='NO_QUALIFIED_MAPPED_VALUE_IN_THIS_DOCUMENT'),\nmapped AS MATERIALIZED(SELECT DISTINCT metric,concept FROM population_top3000_202608_202609_v1.financial_shared_mapping_v1() WHERE family_id='F02' AND metric IN ('revenue','net_income','operating_income','gross_profit','eps_diluted','operating_cash_flow','capex','cash','assets','liabilities','equity')),\ncandidates AS MATERIALIZED(SELECT g.document_key,g.metric,f.ordinal,f.canonical_concept,f.record_sha256,f.payload->>'extraction_state' state,f.payload->>'unit' unit,f.payload->>'period_kind' period_kind,f.payload->>'period_start' period_start,f.payload->>'period_end' period_end,f.payload->>'dimension_count' dimensions\nFROM gaps g JOIN mapped m USING(metric) JOIN population_top3000_202608_202609_v1.financial_shared_fact_v1 f ON f.document_key=g.document_key AND regexp_replace(f.canonical_concept,'^.*:','')=m.concept\nWHERE NOT EXISTS(SELECT 1 FROM population_top3000_202608_202609_v1.financial_shared_mapping_v1() x WHERE x.family_id='F03' AND x.metric=g.metric AND x.concept=f.canonical_concept))\nSELECT metric,canonical_concept,state,unit,period_kind,dimensions,count(*) fact_rows,count(DISTINCT document_key) documents,\nencode(sha256(convert_to(string_agg(document_key||':'||ordinal::text||':'||record_sha256,E'\\n' ORDER BY document_key,ordinal),'UTF8')),'hex') candidate_manifest_sha256 FROM candidates GROUP BY 1,2,3,4,5,6 ORDER BY metric,canonical_concept;",
