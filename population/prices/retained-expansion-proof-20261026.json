  "sql": "WITH pop AS (SELECT value p FROM population_top3000_202608_202609_v1.pipeline_event e CROSS JOIN LATERAL jsonb_array_elements(e.details->'population') WHERE e.event_id=84959), o AS MATERIALIZED(SELECT o.* FROM population_top3000_202608_202609_v1.working_retained_price_observations_v2 o JOIN pop ON o.manifest_id=p->>'manifest_id'), cmp AS (SELECT o.*,b.bar_ts source_ts,(float8send(o.open),float8send(o.high),float8send(o.low),float8send(o.close),o.volume,o.trade_count,float8send(o.vwap)) IS DISTINCT FROM (float8send(b.open),float8send(b.high),float8send(b.low),float8send(b.close),b.volume,b.trade_count,float8send(b.vwap)) mismatch FROM o LEFT JOIN market_fixed_20250901_20260831.alpaca_sip_bars_1m_202608 b ON b.instrument_key=o.instrument_key AND b.bar_ts=o.bar_ts)\nSELECT jsonb_build_object('rows',count(*),'source_matches',count(source_ts),'binary_mismatches',count(*)filter(where mismatch),'digest',encode(sha256(convert_to(string_agg(source_row_sha256,chr(10) ORDER BY manifest_id,bar_ts),'UTF8')),'hex'),'relation_bytes',pg_total_relation_size('population_top3000_202608_202609_v1.retained_price_observation_v2')+pg_total_relation_size('population_top3000_202608_202609_v1.retained_price_expectation_v2'),'tasks',(SELECT jsonb_agg(jsonb_build_object('task_id',task_id,'status',status,'stage',stage,'blocker',blocker_code,'ordinal',payload->'batch_ordinal')) FROM population_top3000_202608_202609_v1.pipeline_task WHERE payload->>'expansion_claim_event_id'='84957')) proof FROM cmp;"
